// Conventions (spec v2.0): every id / *_id column is uuid (UUIDv7 defaults), timestamps are
// timestamptz, columns are snake_case via @map, every model carries `/// @owner <module>`,
// every tenant table has @@unique([tenantId, id]) and composite FKs to tenant parents.
// RLS, grants, partial indexes and partitions live in raw-SQL migrations (R-STK-05).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AccountType {
  BUSINESS
  PARTICIPANT
}

enum MembershipRole {
  BUSINESS_OWNER
  BUSINESS_ADMINISTRATOR
  CAMPAIGN_MANAGER
  CAMPAIGN_OPERATOR
  ANALYST
  MODERATOR
}

/// @owner business
/// A Business is a tenant: its id is the tenantId used by RLS on every other tenant table.
model Business {
  id        String         @id @default(uuid(7)) @db.Uuid
  name      String
  status    BusinessStatus @default(PENDING)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  memberships Membership[]

  @@map("businesses")
}

/// @owner identity
/// Global user identity (a person may belong to several businesses). Not tenant-scoped.
model User {
  id                String      @id @default(uuid(7)) @db.Uuid
  email             String      @unique
  name              String
  accountType       AccountType @default(BUSINESS) @map("account_type")
  passwordHash      String?     @map("password_hash")
  emailVerifiedAt   DateTime?   @map("email_verified_at") @db.Timestamptz
  failedLoginCount  Int         @default(0) @map("failed_login_count")
  lockedUntil       DateTime?   @map("locked_until") @db.Timestamptz
  lastFailedLoginAt DateTime?   @map("last_failed_login_at") @db.Timestamptz
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz

  memberships        Membership[]
  sessions           Session[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]

  @@map("users")
}

/// @owner identity
model Membership {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz

  business Business  @relation(fields: [tenantId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  sessions Session[]

  @@unique([tenantId, id])
  // Partial unique (tenant_id, user_id) WHERE deleted_at IS NULL is created in raw SQL (R-DAT-09).
  @@index([userId])
  @@map("memberships")
}

/// @owner messaging
/// Transactional outbox (spec Appendix B.4). `seq` is an ordering sequence, not an identifier.
model OutboxEvent {
  seq              BigInt    @id @default(autoincrement())
  id               String    @unique @default(uuid(7)) @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid
  partition        Int       @db.SmallInt
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion BigInt    @map("aggregate_version")
  eventType        String    @map("event_type")
  envelope         Json
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  dispatchedAt     DateTime? @map("dispatched_at") @db.Timestamptz
  attempts         Int       @default(0)
  lastError        String?   @map("last_error")
  quarantinedAt    DateTime? @map("quarantined_at") @db.Timestamptz

  @@unique([aggregateId, aggregateVersion])
  // Partial index outbox_pending_idx (partition, seq) WHERE undispatched is created in raw SQL.
  @@map("outbox_events")
}

/// @owner messaging
/// Inbox: consumer idempotency (R-EVT-06). Retention >= 30 days; partitioning is a follow-up.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumer, eventId])
  @@map("processed_events")
}

/// @owner audit
/// Append-only audit trail (R-SEC-04). UPDATE/DELETE/TRUNCATE are revoked from app roles.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

/// @owner identity
/// Server-side session (R-IAM-01). Only a SHA-256 hash of the opaque 256-bit token is stored.
/// The active tenant is derived from the active membership, never from client input (R-TEN-12).
model Session {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tokenHash          String    @unique @map("token_hash")
  userId             String    @map("user_id") @db.Uuid
  activeTenantId     String?   @map("active_tenant_id") @db.Uuid
  activeMembershipId String?   @map("active_membership_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz

  user             User        @relation(fields: [userId], references: [id])
  activeMembership Membership? @relation(fields: [activeTenantId, activeMembershipId], references: [tenantId, id])

  @@index([userId])
  @@map("sessions")
}

/// @owner identity
/// Single-use email verification token (hash only), 24 h expiry.
model EmailVerification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_verifications")
}

/// @owner identity
/// Single-use password reset token (hash only), 1 h expiry.
model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_resets")
}
