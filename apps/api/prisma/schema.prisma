// Conventions (spec v2.0): every id / *_id column is uuid (UUIDv7 defaults), timestamps are
// timestamptz, columns are snake_case via @map, every model carries `/// @owner <module>`,
// every tenant table has @@unique([tenantId, id]) and composite FKs to tenant parents.
// RLS, grants, partial indexes and partitions live in raw-SQL migrations (R-STK-05).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AccountType {
  BUSINESS
  PARTICIPANT
}

enum MembershipRole {
  BUSINESS_OWNER
  BUSINESS_ADMINISTRATOR
  CAMPAIGN_MANAGER
  CAMPAIGN_OPERATOR
  ANALYST
  MODERATOR
}

enum TemplateArchetype {
  GIVEAWAY
  QUIZ
  SURVEY
  INSTANT
  POLL
  VOTE
}

enum CampaignFieldKind {
  FULL_NAME
  EMAIL
  PHONE
  ADDRESS
  WALLET
  CHOICE
  LIKERT
  UPLOAD
  TEXT
  LONG_TEXT
  CONSENT
  QUIZ_QUESTION
  CANDIDATE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  LIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// @owner business
/// A Business is a tenant: its id is the tenantId used by RLS on every other tenant table.
model Business {
  id        String         @id @default(uuid(7)) @db.Uuid
  name      String
  status    BusinessStatus @default(PENDING)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  memberships Membership[]
  campaigns   Campaign[]

  @@map("businesses")
}

/// @owner identity
/// Global user identity (a person may belong to several businesses). Not tenant-scoped.
model User {
  id                String      @id @default(uuid(7)) @db.Uuid
  email             String      @unique
  name              String
  accountType       AccountType @default(BUSINESS) @map("account_type")
  passwordHash      String?     @map("password_hash")
  emailVerifiedAt   DateTime?   @map("email_verified_at") @db.Timestamptz
  failedLoginCount  Int         @default(0) @map("failed_login_count")
  lockedUntil       DateTime?   @map("locked_until") @db.Timestamptz
  lastFailedLoginAt DateTime?   @map("last_failed_login_at") @db.Timestamptz
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz

  memberships        Membership[]
  sessions           Session[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  quizAttempts       QuizAttempt[]
  surveyResponses    SurveyResponse[]
  votes              Vote[]
  giveawayEntries    GiveawayEntry[]
  rewardAwards       RewardAward[]
  rewardClaims       RewardClaim[]
  scamReports        ScamReport[] @relation("ScamReportReporter")
  resolvedReports    ScamReport[] @relation("ScamReportResolver")
  platformStaff      PlatformStaff?
  pointsLedger       PointsLedger[]
  signals            ParticipationSignal[]

  @@map("users")
}

/// @owner identity
model Membership {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz

  business Business  @relation(fields: [tenantId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  sessions Session[]

  @@unique([tenantId, id])
  // Partial unique (tenant_id, user_id) WHERE deleted_at IS NULL is created in raw SQL (R-DAT-09).
  @@index([userId])
  @@map("memberships")
}

/// @owner messaging
/// Transactional outbox (spec Appendix B.4). `seq` is an ordering sequence, not an identifier.
model OutboxEvent {
  seq              BigInt    @id @default(autoincrement())
  id               String    @unique @default(uuid(7)) @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid
  partition        Int       @db.SmallInt
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion BigInt    @map("aggregate_version")
  eventType        String    @map("event_type")
  envelope         Json
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  dispatchedAt     DateTime? @map("dispatched_at") @db.Timestamptz
  attempts         Int       @default(0)
  lastError        String?   @map("last_error")
  quarantinedAt    DateTime? @map("quarantined_at") @db.Timestamptz

  @@unique([aggregateId, aggregateVersion])
  // Partial index outbox_pending_idx (partition, seq) WHERE undispatched is created in raw SQL.
  @@map("outbox_events")
}

/// @owner messaging
/// Inbox: consumer idempotency (R-EVT-06). Retention >= 30 days; partitioning is a follow-up.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumer, eventId])
  @@map("processed_events")
}

/// @owner audit
/// Append-only audit trail (R-SEC-04). UPDATE/DELETE/TRUNCATE are revoked from app roles.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

/// @owner identity
/// Server-side session (R-IAM-01). Only a SHA-256 hash of the opaque 256-bit token is stored.
/// The active tenant is derived from the active membership, never from client input (R-TEN-12).
model Session {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tokenHash          String    @unique @map("token_hash")
  userId             String    @map("user_id") @db.Uuid
  activeTenantId     String?   @map("active_tenant_id") @db.Uuid
  activeMembershipId String?   @map("active_membership_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz

  user             User        @relation(fields: [userId], references: [id])
  activeMembership Membership? @relation(fields: [activeTenantId, activeMembershipId], references: [tenantId, id])

  @@index([userId])
  @@map("sessions")
}

/// @owner identity
/// Single-use email verification token (hash only), 24 h expiry.
model EmailVerification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_verifications")
}

/// @owner identity
/// Single-use password reset token (hash only), 1 h expiry.
model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_resets")
}

/// @owner campaigns
/// A campaign a business runs from a published template: what the public page says, who can win what,
/// and when it runs. Tenant-scoped (RLS). Soft-deleted via deletedAt (R-DAT-09). Only a DRAFT is
/// editable; the page address (slug) is fixed when the campaign is launched (R-TEN-07).
model Campaign {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  /// The built-in campaign type. Optional while drafting; required to launch.
  templateId  String?        @map("template_id") @db.Uuid
  title       String
  summary     String         @default("")
  /// Unique across all businesses: the public page is /c/{slug}. Null until launch.
  slug        String?        @unique
  status      CampaignStatus @default(DRAFT)
  startAt     DateTime?      @map("start_at") @db.Timestamptz
  endAt       DateTime?      @map("end_at") @db.Timestamptz
  /// Optimistic concurrency: bumped on every change; writers send the version they read.
  version     Int            @default(1)
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  launchedAt  DateTime?      @map("launched_at") @db.Timestamptz
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz
  /// Set when the business archives the campaign (put away, not deleted); null otherwise.
  archivedAt  DateTime?      @map("archived_at") @db.Timestamptz
  /// Participants admitted so far (counted once each, when they first join). A prize pool campaign closes
  /// when this reaches its limit.
  participantCount Int          @default(0) @map("participant_count")
  /// Settings the campaign type uses, e.g. {"quiz": {"timeLimitMinutes": 10, "passPercent": 70}}.
  settings    Json           @default("{}")

  business        Business          @relation(fields: [tenantId], references: [id])
  template        CampaignTemplate? @relation(fields: [templateId], references: [id])
  prizes          CampaignPrize[]
  fields          CampaignField[]
  attempts        QuizAttempt[]
  surveyResponses SurveyResponse[]
  votes           Vote[]
  giveawayEntries GiveawayEntry[]
  rewardAwards    RewardAward[]
  scamReports     ScamReport[]
  rewardDraws     RewardDraw[]
  signals         ParticipationSignal[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
  @@index([tenantId, templateId])
  @@index([tenantId, archivedAt])
  @@map("campaigns")
}

/// @owner templates
/// A built-in campaign type (quiz, survey, giveaway, instant win). Global and read-only for businesses:
/// seeded, and later managed by platform admins. It says what a campaign of that type may contain.
model CampaignTemplate {
  id               String            @id @default(uuid(7)) @db.Uuid
  slug             String            @unique
  name             String
  archetype        TemplateArchetype
  description      String            @default("")
  /// A campaign needs at least this many content fields (questions) to launch.
  minContentFields Int               @default(0) @map("min_content_fields")
  /// A campaign of this type must say what is being given away.
  requiresPrizes   Boolean           @default(false) @map("requires_prizes")
  position         Int               @default(0)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz

  fields    CampaignTemplateField[]
  campaigns Campaign[]

  @@map("campaign_templates")
}

/// @owner templates
/// One field kind a template allows, with how many a campaign may have and what a new campaign starts with.
model CampaignTemplateField {
  id              String            @id @default(uuid(7)) @db.Uuid
  templateId      String            @map("template_id") @db.Uuid
  kind            CampaignFieldKind
  position        Int               @default(0)
  /// Null means no limit.
  maxCount        Int?              @map("max_count")
  /// How many of this kind a new campaign of this type starts with.
  defaultCount    Int               @default(0) @map("default_count")
  defaultLabel    String            @default("") @map("default_label")
  defaultRequired Boolean           @default(false) @map("default_required")

  template CampaignTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, kind])
  @@map("campaign_template_fields")
}

/// @owner campaigns
/// One field of a campaign, in `position` order: what the participant is asked (their details) or the
/// content of the campaign (quiz questions, survey questions). Replaced as a set when the draft is saved.
/// `correctIndex` is only for a quiz question and never leaves the server while the quiz runs.
model CampaignField {
  id           String            @id @default(uuid(7)) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  campaignId   String            @map("campaign_id") @db.Uuid
  position     Int
  kind         CampaignFieldKind
  /// Machine name (snake_case), unique within the campaign.
  key          String
  label        String
  helper       String            @default("")
  required     Boolean           @default(false)
  /// Answers of a choice or quiz question; empty for other kinds.
  options      String[]          @default([])
  correctIndex Int?              @map("correct_index")
  /// A candidate's picture in an image vote (an https link); empty for every other kind of field.
  imageUrl     String            @default("") @map("image_url")

  campaign      Campaign       @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  answers       QuizAnswer[]
  surveyAnswers SurveyAnswer[]
  votes         Vote[]

  @@unique([tenantId, id])
  @@unique([tenantId, campaignId, key])
  @@index([tenantId, campaignId, position])
  @@map("campaign_fields")
}

/// @owner campaigns
/// One prize tier of a campaign, in `position` order. Replaced as a set when the campaign is saved.
model CampaignPrize {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  campaignId  String @map("campaign_id") @db.Uuid
  position    Int
  name        String
  /// Free text shown as written (for example "GH₵ 5,000"); the platform does not handle money.
  valueLabel  String @default("") @map("value_label")
  winners     Int    @default(1)
  description String @default("")
  /// What the prize is: money, points or an item. Existing prizes are items shown as text.
  kind        PrizeKind       @default(ITEM)
  /// Whole minor units (cash) or points; null while only the text label is used.
  amountMinor BigInt?         @map("amount_minor")
  currency    String?
  /// Placing range this prize covers (1st is 1 to 1; 2nd to 5th is 2 to 5).
  rankFrom    Int?            @map("rank_from")
  rankTo      Int?            @map("rank_to")
  selection   PrizeSelection?

  campaign Campaign      @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  awards   RewardAward[]

  @@unique([tenantId, id])
  @@index([tenantId, campaignId, position])
  @@map("campaign_prizes")
}

/// @owner quiz
/// A participant's attempt: numbered from 1 per participant per campaign (a retake is the next number, up to
/// the quiz's "attempts allowed"). `expiresAt` is set when it starts, from the
/// time limit, and is the only clock that counts. Scored by the server when submitted or expired.
model QuizAttempt {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  campaignId    String    @map("campaign_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  attemptNumber Int       @default(1) @map("attempt_number")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz
  score         Int?
  total         Int?
  passed        Boolean?

  campaign Campaign     @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id])
  answers  QuizAnswer[]

  @@unique([tenantId, id])
  @@unique([tenantId, campaignId, userId, attemptNumber])
  @@index([tenantId, userId])
  @@map("quiz_attempts")
}

/// @owner quiz
/// The option a participant chose for one question; one row per question per attempt.
model QuizAnswer {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  attemptId   String   @map("attempt_id") @db.Uuid
  questionId  String   @map("question_id") @db.Uuid
  choiceIndex Int      @map("choice_index")
  answeredAt  DateTime @default(now()) @map("answered_at") @db.Timestamptz

  attempt  QuizAttempt   @relation(fields: [tenantId, attemptId], references: [tenantId, id], onDelete: Cascade)
  question CampaignField @relation(fields: [tenantId, questionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, attemptId, questionId])
  @@map("quiz_answers")
}

/// @owner survey
/// A participant's response to a survey campaign: one per participant per campaign. It is open while
/// `submittedAt` is empty (answers can change) and final once it is set.
model SurveyResponse {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  campaignId  String    @map("campaign_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz

  campaign Campaign       @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id])
  answers  SurveyAnswer[]

  @@unique([tenantId, id])
  @@unique([tenantId, campaignId, userId])
  @@index([tenantId, userId])
  @@map("survey_responses")
}

/// @owner survey
/// One answer to one survey question: the chosen option (a choice or a rating, counted from 0) or the
/// written text. Exactly one of the two is set.
model SurveyAnswer {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  responseId  String   @map("response_id") @db.Uuid
  questionId  String   @map("question_id") @db.Uuid
  choiceIndex Int?     @map("choice_index")
  text        String?
  answeredAt  DateTime @default(now()) @map("answered_at") @db.Timestamptz

  response SurveyResponse @relation(fields: [tenantId, responseId], references: [tenantId, id], onDelete: Cascade)
  question CampaignField  @relation(fields: [tenantId, questionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, responseId, questionId])
  @@map("survey_answers")
}

/// @owner vote
/// One participant's vote in a poll or an image vote: final, one per participant per campaign. `fieldId` is
/// the poll's question or the candidate chosen; `choiceIndex` is the answer of a poll (null for an image vote).
model Vote {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  fieldId     String   @map("field_id") @db.Uuid
  choiceIndex Int?     @map("choice_index")
  castAt      DateTime @default(now()) @map("cast_at") @db.Timestamptz

  campaign Campaign      @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])
  field    CampaignField @relation(fields: [tenantId, fieldId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, campaignId, userId])
  @@index([tenantId, campaignId, fieldId])
  @@index([tenantId, userId])
  @@map("votes")
}

/// @owner giveaway
/// One participant's entry in a giveaway: one per participant per campaign, with a ticket number
/// (1, 2, 3... in the order people entered).
model GiveawayEntry {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  campaignId   String   @map("campaign_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  ticketNumber Int      @map("ticket_number")
  enteredAt    DateTime @default(now()) @map("entered_at") @db.Timestamptz

  campaign Campaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, campaignId, userId])
  @@unique([tenantId, campaignId, ticketNumber])
  @@index([tenantId, userId])
  @@map("giveaway_entries")
}

enum PrizeKind {
  CASH
  POINTS
  ITEM
}

enum PrizeSelection {
  RANKING
  DRAW
  POOL
  INSTANT
  COMPLETION
}

enum AwardStatus {
  PENDING_REVIEW
  AVAILABLE
  CLAIMED
  FULFILLED
  HELD
  REJECTED
  EXPIRED
  REVOKED
}

enum PayoutMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  DELIVERY
}

enum SignalKind {
  JOIN
  CLAIM
}

/// @owner rewards
/// One winning slot. `prizeId` is null for an equal share of a prize pool. Partial unique indexes (raw SQL)
/// stop a slot or a person being awarded twice. The amount is a snapshot taken when the award is made.
model RewardAward {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  campaignId  String         @map("campaign_id") @db.Uuid
  prizeId     String?        @map("prize_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  slot        Int            @default(1)
  rank        Int?
  kind        PrizeKind
  amountMinor BigInt?        @map("amount_minor")
  currency    String?
  source      PrizeSelection
  status      AwardStatus    @default(PENDING_REVIEW)
  riskScore   Int            @default(0) @map("risk_score")
  claimBy     DateTime?      @map("claim_by") @db.Timestamptz
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  campaign Campaign       @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  prize    CampaignPrize? @relation(fields: [tenantId, prizeId], references: [tenantId, id])
  user     User           @relation(fields: [userId], references: [id])
  events   RewardEvent[]
  ledger   PointsLedger[]
  claim    RewardClaim?
  reports  ScamReport[]

  @@unique([tenantId, id])
  @@index([tenantId, campaignId, status])
  @@index([tenantId, userId])
  @@map("reward_awards")
}

/// @owner rewards
/// Append-only timeline of an award.
model RewardEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  awardId    String       @map("award_id") @db.Uuid
  actorId    String?      @map("actor_id") @db.Uuid
  type       String
  fromStatus AwardStatus? @map("from_status")
  toStatus   AwardStatus? @map("to_status")
  reasonCode String?      @map("reason_code")
  metadata   Json         @default("{}")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz

  award RewardAward @relation(fields: [tenantId, awardId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, awardId, createdAt])
  @@map("reward_events")
}

/// @owner rewards
/// Append-only points. The balance is the sum of `delta`; `idempotencyKey` makes a replay a no-op.
model PointsLedger {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  awardId        String?      @map("award_id") @db.Uuid
  delta          BigInt
  reason         String
  idempotencyKey String       @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user  User         @relation(fields: [userId], references: [id])
  award RewardAward? @relation(fields: [tenantId, awardId], references: [tenantId, id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, userId])
  @@map("points_ledger")
}

/// @owner rewards
/// A reproducible draw: the sealed rules, the entrant snapshot, the entropy and seed, and the winners.
model RewardDraw {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  campaignId   String    @map("campaign_id") @db.Uuid
  rulesHash    String    @map("rules_hash")
  sealedAt     DateTime  @map("sealed_at") @db.Timestamptz
  entrantsHash String?   @map("entrants_hash")
  entrantCount Int?      @map("entrant_count")
  entropy      String?
  seed         String?
  winners      Json      @default("[]")
  drawnAt      DateTime? @map("drawn_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  campaign Campaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, campaignId])
  @@map("reward_draws")
}

/// @owner rewards
/// Abuse-detection facts about a participation: HMAC hashes only, never the raw IP or user agent.
model ParticipationSignal {
  id         String     @id @default(uuid(7)) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  campaignId String     @map("campaign_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  kind       SignalKind
  ipHash     String?    @map("ip_hash")
  uaHash     String?    @map("ua_hash")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  campaign Campaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([tenantId, campaignId, ipHash])
  @@index([tenantId, userId])
  @@index([createdAt])
  @@map("participation_signals")
}

/// @owner rewards
/// Where a cash or item award should go. The destination is encrypted; the hash is keyed (for spotting one
/// destination used by many accounts) and the hint is the masked tail shown back to people. One per award.
model RewardClaim {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  awardId         String       @map("award_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  method          PayoutMethod
  accountName     String       @map("account_name")
  destinationEnc  String       @map("destination_enc")
  destinationHash String       @map("destination_hash")
  destinationHint String       @map("destination_hint")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz

  award RewardAward @relation(fields: [tenantId, awardId], references: [tenantId, id])
  user  User        @relation(fields: [userId], references: [id])

  @@unique([tenantId, awardId])
  @@index([tenantId, destinationHash])
  @@index([tenantId, userId])
  @@map("reward_claims")
}

enum ScamReason {
  ASKED_TO_PAY
  SUSPICIOUS_CONTACT
  NOT_RECEIVED
  OTHER
}

enum ScamReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

/// @owner rewards
/// A winner's report that something about an award looks like a scam (asked to pay a fee, odd contact, not
/// received). The reporter can read their own; the business can neither read nor tell who reported (no
/// tenant read policy); the platform reviews them. `severity` orders the review queue and comes from the
/// reason alone.
model ScamReport {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  campaignId String           @map("campaign_id") @db.Uuid
  awardId    String           @map("award_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  reason     ScamReason
  details    String           @default("")
  severity   Int
  status     ScamReportStatus @default(OPEN)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  /// Set by the platform when it reviews the report.
  resolvedById String?        @map("resolved_by") @db.Uuid
  resolvedAt   DateTime?      @map("resolved_at") @db.Timestamptz
  resolution   String        @default("")

  campaign Campaign    @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  award    RewardAward @relation(fields: [tenantId, awardId], references: [tenantId, id])
  user     User        @relation("ScamReportReporter", fields: [userId], references: [id])
  resolver User?       @relation("ScamReportResolver", fields: [resolvedById], references: [id])

  @@unique([tenantId, awardId, userId, reason])
  @@index([tenantId, campaignId])
  @@index([status, severity])
  @@map("scam_reports")
}

/// @owner rewards
/// Fixed-window counters for rate limiting that hold across server instances. The key is a caller-chosen
/// string (already hashed or an opaque id); no personal data. Old windows are pruned as the limiter runs.
model RateLimitCounter {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz
  count       Int

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_counters")
}

enum PlatformRole {
  PLATFORM_REVIEWER
}

/// @owner administration
/// People who work for the platform and may review rewards across businesses. Not reachable by the runtime
/// role at all (no grant): only the platform role reads it, and rows are added by an operator
/// (`npm run platform:grant-staff`), never through the app.
model PlatformStaff {
  userId    String       @id @map("user_id") @db.Uuid
  role      PlatformRole @default(PLATFORM_REVIEWER)
  grantedAt DateTime     @default(now()) @map("granted_at") @db.Timestamptz
  revokedAt DateTime?    @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("platform_staff")
}
