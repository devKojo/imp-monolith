{
  "name": "@imp/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite-node --watch src/main.ts",
    "build": "vite build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "smoke:db": "vite-node scripts/smoke-db.ts",
    "db:provision-roles": "vite-node scripts/db/provision-roles.ts",
    "db:check": "npm run db:check-ownership && npm run db:check-fk && npm run db:check-uuid && npm run db:connection-budget",
    "db:check-ownership": "vite-node scripts/db/check-ownership.ts",
    "db:check-fk": "vite-node scripts/db/check-fk.ts",
    "db:check-uuid": "vite-node scripts/db/check-uuid.ts",
    "db:connection-budget": "vite-node scripts/db/connection-budget.ts",
    "db:verify": "vite-node scripts/db/verify-rls.ts && vite-node scripts/db/verify-db-objects.ts && vite-node scripts/db/check-uuid.ts --db"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "amqplib": "^0.10.5",
    "argon2": "0.45.1",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "vite": "^6.0.0",
    "vite-node": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
