{
  "name": "imp-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @imp/api",
    "dev:web": "npm run dev -w @imp/web",
    "build": "npm run build -w @imp/api && npm run build -w @imp/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke:db": "npm run smoke:db -w @imp/api",
    "db:migrate": "npm run prisma:migrate -w @imp/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.2"
  },
  "lint-staged": {
    "*.{ts,js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
