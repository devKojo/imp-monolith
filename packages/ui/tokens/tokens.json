{
  "$comment": "Single source for design tokens (UI-FND-01). Edit this file, then run `npm run tokens:build -w @imp/ui`. Components consume SEMANTIC tokens only. Values from UI/UX spec v1.0 section 3.",
  "raw": {
    "text-900": "#101828",
    "text-700": "#344054",
    "text-600": "#475467",
    "white": "#FFFFFF",
    "gray-50": "#F9FAFB",
    "gray-300": "#D0D5DD",
    "gray-500": "#667085",
    "brand-50": "#EFF4FF",
    "brand-700": "#1D4ED8",
    "success-50": "#ECFDF3",
    "success-700": "#067647",
    "warning-50": "#FFFAEB",
    "warning-800": "#93370D",
    "danger-50": "#FEF3F2",
    "danger-700": "#B42318",
    "chart-1": "#0072B2",
    "chart-2": "#D55E00",
    "chart-3": "#009E73",
    "chart-4": "#CC79A7",
    "chart-5": "#56B4E9",
    "gray-100": "#F2F4F7",
    "brand-800": "#1E40AF",
    "brand-900": "#172554",
    "danger-800": "#912018",
    "danger-900": "#7A1B14",
    "page-bg": "#F9F9FF",
    "control-500": "#868CA0",
    "line-200": "#DBE2F9",
    "tint-100": "#F1F3FF"
  },
  "semantic": {
    "text-primary": "text-900",
    "text-secondary": "text-700",
    "text-hint": "text-600",
    "surface": "white",
    "surface-subtle": "tint-100",
    "border": "line-200",
    "border-strong": "control-500",
    "action-primary": "brand-700",
    "action-primary-text": "white",
    "focus-ring": "brand-700",
    "link": "brand-700",
    "selected-bg": "brand-50",
    "selected-text": "brand-700",
    "info-bg": "brand-50",
    "info-text": "brand-700",
    "success-bg": "success-50",
    "success-text": "success-700",
    "warning-bg": "warning-50",
    "warning-text": "warning-800",
    "danger-bg": "danger-50",
    "danger-text": "danger-700",
    "overlay": "text-900",
    "action-primary-hover": "brand-800",
    "action-primary-active": "brand-900",
    "danger-action": "danger-700",
    "danger-action-hover": "danger-800",
    "danger-action-active": "danger-900",
    "surface-hover": "tint-100",
    "surface-pressed": "gray-100",
    "surface-page": "page-bg"
  },
  "chartSeries": [
    {
      "token": "chart-1",
      "marker": "circle",
      "dash": "none",
      "name": "Series 1"
    },
    {
      "token": "chart-2",
      "marker": "square",
      "dash": "6 4",
      "name": "Series 2"
    },
    {
      "token": "chart-3",
      "marker": "triangle",
      "dash": "2 3",
      "name": "Series 3"
    },
    {
      "token": "chart-4",
      "marker": "diamond",
      "dash": "8 3 2 3",
      "name": "Series 4"
    },
    {
      "token": "chart-5",
      "marker": "cross",
      "dash": "12 4",
      "name": "Series 5"
    }
  ],
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "radius": {
    "sm": 2,
    "md": 4,
    "lg": 8,
    "xl": 12,
    "pill": 999
  },
  "elevation": {
    "1": "0 1px 2px 0 rgba(20, 27, 44, 0.06)",
    "2": "0 4px 12px -2px rgba(20, 27, 44, 0.08), 0 2px 4px -2px rgba(20, 27, 44, 0.04)",
    "3": "0 20px 25px -5px rgba(20, 27, 44, 0.10), 0 8px 10px -6px rgba(20, 27, 44, 0.06)"
  },
  "font": {
    "family": "'Inter Variable', Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "styles": {
      "display": {
        "size": 30,
        "line": 38,
        "weight": 700,
        "letterSpacing": "-0.02em"
      },
      "display-mobile": {
        "size": 28,
        "line": 36,
        "weight": 700,
        "letterSpacing": "-0.02em"
      },
      "h1": {
        "size": 24,
        "line": 32,
        "weight": 700,
        "letterSpacing": "-0.015em"
      },
      "h2": {
        "size": 20,
        "line": 28,
        "weight": 600,
        "letterSpacing": "-0.01em"
      },
      "h3": {
        "size": 18,
        "line": 26,
        "weight": 600,
        "letterSpacing": "-0.005em"
      },
      "body-l": {
        "size": 18,
        "line": 28,
        "weight": 400
      },
      "body": {
        "size": 16,
        "line": 24,
        "weight": 400
      },
      "body-s": {
        "size": 14,
        "line": 20,
        "weight": 400
      },
      "caption": {
        "size": 12,
        "line": 16,
        "weight": 500
      },
      "label": {
        "size": 14,
        "line": 20,
        "weight": 500
      },
      "label-sm": {
        "size": 12,
        "line": 16,
        "weight": 600,
        "letterSpacing": "0.02em"
      },
      "hero": {
        "size": 56,
        "line": 56,
        "weight": 800,
        "letterSpacing": "-0.03em"
      }
    }
  },
  "breakpoint": {
    "sm": 480,
    "md": 768,
    "lg": 1024,
    "xl": 1280
  },
  "layout": {
    "reading-column": 720,
    "content-max": 1200
  },
  "target": {
    "public": 44,
    "dashboard": 32,
    "minimum": 24
  },
  "focus": {
    "width": 2,
    "offset": 2
  },
  "motion": {
    "fast": 100,
    "base": 200
  },
  "contrast": [
    {
      "fg": "text-primary",
      "bg": "surface",
      "min": 4.5,
      "use": "Body text on surface"
    },
    {
      "fg": "text-secondary",
      "bg": "surface",
      "min": 4.5,
      "use": "Labels on surface"
    },
    {
      "fg": "text-hint",
      "bg": "surface",
      "min": 4.5,
      "use": "Help text on surface"
    },
    {
      "fg": "text-hint",
      "bg": "surface-subtle",
      "min": 4.5,
      "use": "Help text on subtle surface"
    },
    {
      "fg": "action-primary-text",
      "bg": "action-primary",
      "min": 4.5,
      "use": "Primary button label"
    },
    {
      "fg": "link",
      "bg": "surface",
      "min": 4.5,
      "use": "Links and tertiary buttons"
    },
    {
      "fg": "selected-text",
      "bg": "selected-bg",
      "min": 4.5,
      "use": "Selected item text"
    },
    {
      "fg": "success-text",
      "bg": "success-bg",
      "min": 4.5,
      "use": "Success message"
    },
    {
      "fg": "warning-text",
      "bg": "warning-bg",
      "min": 4.5,
      "use": "Warning message"
    },
    {
      "fg": "danger-text",
      "bg": "danger-bg",
      "min": 4.5,
      "use": "Error message"
    },
    {
      "fg": "danger-text",
      "bg": "surface",
      "min": 4.5,
      "use": "Error text on surface"
    },
    {
      "fg": "border-strong",
      "bg": "surface",
      "min": 3,
      "use": "Input border (non-text)"
    },
    {
      "fg": "focus-ring",
      "bg": "surface",
      "min": 3,
      "use": "Focus ring (non-text)"
    },
    {
      "fg": "focus-ring",
      "bg": "surface-subtle",
      "min": 3,
      "use": "Focus ring on subtle surface"
    },
    {
      "fg": "text-secondary",
      "bg": "surface-subtle",
      "min": 4.5,
      "use": "Neutral chip text"
    },
    {
      "fg": "info-text",
      "bg": "info-bg",
      "min": 4.5,
      "use": "Info banner and chip"
    },
    {
      "fg": "chart-1",
      "bg": "surface",
      "min": 3,
      "use": "Chart series 1 (graphical)"
    },
    {
      "fg": "chart-2",
      "bg": "surface",
      "min": 3,
      "use": "Chart series 2 (graphical)"
    },
    {
      "fg": "chart-3",
      "bg": "surface",
      "min": 3,
      "use": "Chart series 3 (graphical)"
    },
    {
      "fg": "chart-4",
      "bg": "surface",
      "min": 3,
      "use": "Chart series 4 (graphical)"
    },
    {
      "fg": "chart-5",
      "bg": "surface",
      "min": 3,
      "use": "Chart series 5 (graphical)",
      "waiver": {
        "min": 2.3,
        "reason": "Spec 3.2 palette value #56B4E9 is 2.31:1, below the 3:1 of UI-A11Y-10. Series 5 MUST be drawn with a marker, a dash style and a direct label, never colour alone. Needs design sign-off (ADR-F004)."
      }
    },
    {
      "fg": "action-primary-text",
      "bg": "action-primary-hover",
      "min": 4.5,
      "use": "Primary button label (hover)"
    },
    {
      "fg": "action-primary-text",
      "bg": "action-primary-active",
      "min": 4.5,
      "use": "Primary button label (pressed)"
    },
    {
      "fg": "action-primary-text",
      "bg": "danger-action",
      "min": 4.5,
      "use": "Danger button label"
    },
    {
      "fg": "action-primary-text",
