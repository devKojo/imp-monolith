{
  "name": "@imp/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nuxt layer: design tokens, component library and gallery (UI/UX spec v1.0, section 5)",
  "main": "./nuxt.config.ts",
  "scripts": {
    "tokens:build": "vite-node scripts/build-tokens.ts",
    "tokens:check": "vite-node scripts/build-tokens.ts --check",
    "catalogue:build": "vite-node scripts/build-catalogue.ts",
    "catalogue:check": "vite-node scripts/build-catalogue.ts --check",
    "lint:ui": "vite-node scripts/lint-ui.ts",
    "check": "npm run tokens:check && npm run catalogue:check && npm run lint:ui",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "vite-node": "^3.0.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0"
  }
}
