# API
PORT=3000
NODE_ENV=development
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Database: local or managed PostgreSQL (no containers). One role per purpose (spec R-TEN-02).
# app_runtime: DML on tenant tables, subject to RLS (used through withTenant)
DATABASE_URL=postgresql://app_runtime:PASSWORD@localhost:5432/DB_NAME?schema=public
# app_system: outbox/inbox only (publisher, scheduler). Optional until those profiles exist.
DATABASE_URL_SYSTEM=
# app_platform: BYPASSRLS, Administration module only. Optional.
DATABASE_URL_PLATFORM=
# Read replica for reports (optional)
DATABASE_URL_READ=
# app_migrator: owner, DDL only; used by `prisma migrate` (falls back to DATABASE_URL if unset)
MIGRATE_DATABASE_URL=postgresql://app_migrator:PASSWORD@localhost:5432/DB_NAME?schema=public
# pg pool size per process (replicas x this must fit the connection budget)
DB_POOL_MAX=10

# One-off role provisioning (npm run db:provision-roles -w @imp/api); never commit real values
# PROVISION_DATABASE_URL=postgresql://admin:PASSWORD@localhost:5432/DB_NAME
# APP_MIGRATOR_PASSWORD=
# APP_RUNTIME_PASSWORD=
# APP_SYSTEM_PASSWORD=
# APP_PLATFORM_PASSWORD=

# Sessions: HMAC key for CSRF tokens (>= 32 chars, required in production) and allowed origins
# SESSION_SECRET=generate-with-openssl-rand-hex-32
APP_ORIGINS=http://localhost:3000

# Web
NUXT_PUBLIC_API_BASE=http://localhost:3000

# Public origin of the site; used in email links and as the Google OAuth redirect base.
APP_PUBLIC_URL=http://localhost:3000

# Email via Gmail SMTP. Needs 2-Step Verification on the Google account, then an App Password:
# https://myaccount.google.com/apppasswords (16 characters; never the account password).
# Leave SMTP_USER/SMTP_PASS empty to print verification tokens to the API console (development only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Sign in with Google (participants). Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add this authorised redirect URI:
#   http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to true once the two values above are filled in, to show the Google button.
NUXT_PUBLIC_GOOGLE_SIGNIN=false
